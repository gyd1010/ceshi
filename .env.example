# 应用配置
DEBUG=false
ENV=production
LOG_LEVEL=INFO

# 数据库配置
DATABASE_URL=postgresql://user:password@localhost:5432/order_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis配置
REDIS_URL=redis://localhost:6379/0
REDIS_POOL_SIZE=50

# RabbitMQ配置
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=order_exchange

# 订单配置
ORDER_EXPIRE_MINUTES=30
PRESALE_DEPOSIT_EXPIRE_HOURS=24
PRESALE_FINAL_PAY_EXPIRE_HOURS=72

# 库存配置
INVENTORY_LOCK_TIMEOUT_SECONDS=300
INVENTORY_RETRY_TIMES=3
